# Normalize text files to LF in the repository, independent of platform.
* text=auto eol=lf

*.mjs text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.patch text eol=lf

# Binary assets — no diff, no EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zst binary
*.zip binary
*.tgz binary

# Generated lockfiles are noise in diffs.
package-lock.json -diff
pnpm-lock.yaml -diff
