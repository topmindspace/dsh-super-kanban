{
  "name": "dsh-super-kanban",
  "version": "0.3.0",
  "description": "AI task kanban for DeepSeek Harness: derives task goals, progress, completion and issues from DSH sessions, with key facts, subtasks, artifacts, session hand-off and a dual full-page/right-sidebar UI.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "server/",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "kanban",
    "task-tracking",
    "ai-agent",
    "session",
    "productivity"
  ],
  "author": "topmindspace",
  "license": "MIT",
  "homepage": "https://github.com/topmindspace/dsh-super-kanban#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topmindspace/dsh-super-kanban.git"
  },
  "bugs": {
    "url": "https://github.com/topmindspace/dsh-super-kanban/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "validate": "node scripts/validate.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "market:index": "node scripts/build-market-index.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm test && npm run validate && npm run check:privacy"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
